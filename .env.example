# Copy this to .env and fill in values
# (docker-compose.yml reads from the environment section, not .env by default)

# Optional. Signs login cookies. Leave this blank (or delete the line) and the
# container generates a key into data/secret.key on first boot and reuses it
# across updates. Set it explicitly only when restoring a backup and you need
# existing logins to keep working. Changing it logs everyone out once.
SECRET_KEY=
ODDS_API_KEY=your-odds-api-key-here
# Registration is invite-only — an admin-issued code is always required. This is
# a master switch for the /register page itself: set false to close it entirely,
# blocking even valid invite holders.
REGISTRATION_OPEN=true
DATABASE_URL=sqlite:////app/data/nal.db

# External (host) port the app is reachable on. The container always listens on
# 8000 internally; this only changes the host-side port. Set to match whatever
# your reverse proxy / Cloudflare tunnel points at (e.g. 5950).
HOST_PORT=8000

# "Submit an Issue" -> GitHub. Easiest set in the app itself: Admin Panel ->
# Issue Reporting, which needs no restart and wins over the values below. These
# are the fallback for a deployment that would rather configure it here. Create a
# fine-grained personal access token with read/write access to Issues on the repo,
# then set both values. With neither set, the feedback page still loads but tells
# users reporting is unavailable.
GITHUB_ISSUE_TOKEN=
GITHUB_ISSUE_REPO=jeffreyrdubois/nationalarmchairleague

# --- Updating the app from its own admin page (optional) --------------------
# Off unless /var/run/docker.sock is mapped into the container; see MANUAL.md
# ("Updating from inside the app") for what that costs you before enabling it.
# None of the below is normally needed — the app finds its own container and
# reads the public registry anonymously.
#
# The container's name, if the app cannot work it out for itself.
UPDATE_CONTAINER_NAME=
# Where the Docker socket is, if not the usual place. Setting this does NOT
# enable anything on its own — the socket still has to be mapped into the
# container as a volume.
# DOCKER_SOCKET=/var/run/docker.sock
# Seconds a new version gets to report healthy before it is rolled back.
UPDATE_HEALTH_TIMEOUT=180
