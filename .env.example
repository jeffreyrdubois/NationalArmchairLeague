# Copy this to .env and fill in values
# (docker-compose.yml reads from the environment section, not .env by default)

SECRET_KEY=change-me-to-a-long-random-secret-key
ODDS_API_KEY=your-odds-api-key-here
REGISTRATION_OPEN=true
DATABASE_URL=sqlite:////app/data/nal.db

# External (host) port the app is reachable on. The container always listens on
# 8000 internally; this only changes the host-side port. Set to match whatever
# your reverse proxy / Cloudflare tunnel points at (e.g. 5950).
HOST_PORT=8000

# "Submit an Issue" -> GitHub. Create a fine-grained personal access token with
# read/write access to Issues on the repo, then set both values. If left unset,
# the feedback page still loads but tells users reporting is unavailable.
GITHUB_ISSUE_TOKEN=
GITHUB_ISSUE_REPO=jeffreyrdubois/nationalarmchairleague
